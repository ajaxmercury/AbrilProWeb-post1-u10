{
	"info": {
		"_postman_id": "c1f7b8a9-4d2e-4b6a-9f1e-8e7c6d5b4a3f",
		"name": "ColeccionCatalogo",
		"description": "Suite de pruebas automatizadas Postman/Newman para el Catalogo de Productos - U10",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Crear Producto Valido (POST)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code es 201 Created\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test(\"Tiempo de respuesta menor a 500ms\", function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(500);",
							"});",
							"",
							"pm.test(\"El cuerpo contiene ID generado y atributos correctos\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('id');",
							"    pm.expect(jsonData.nombre).to.eql('Laptop ThinkPad');",
							"    pm.expect(jsonData.precio).to.eql(1200.50);",
							"    pm.expect(jsonData.categoria).to.eql('Computadores');",
							"    ",
							"    // Guardar variable de entorno para las peticiones subsiguientes",
							"    pm.environment.set(\"productoId\", jsonData.id);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"nombre\": \"Laptop ThinkPad\",\n    \"precio\": 1200.50,\n    \"categoria\": \"Computadores\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/productos",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"productos"
					]
				}
			},
			"response": []
		},
		{
			"name": "2. Consultar Producto por ID (GET)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code es 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Tiempo de respuesta menor a 500ms\", function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(500);",
							"});",
							"",
							"pm.test(\"El producto recuperado coincide con la variable productoId\", function () {",
							"    const jsonData = pm.response.json();",
							"    const expectedId = pm.environment.get(\"productoId\");",
							"    pm.expect(jsonData.id).to.eql(expectedId);",
							"    pm.expect(jsonData.nombre).to.eql('Laptop ThinkPad');",
							"    pm.expect(jsonData.precio).to.eql(1200.50);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/productos/{{productoId}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"productos",
						"{{productoId}}"
					]
				}
			},
			"response": []
		},
		{
			"name": "3. Filtrar Productos por Categoria (GET)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code es 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Tiempo de respuesta menor a 500ms\", function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(500);",
							"});",
							"",
							"pm.test(\"Retorna arreglo con productos de la categoria especificada\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.be.an('array');",
							"    pm.expect(jsonData.length).to.be.at.least(1);",
							"    jsonData.forEach(function(item) {",
							"        pm.expect(item.categoria).to.eql('Computadores');",
							"    });",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/productos?categoria=Computadores",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"productos"
					],
					"query": [
						{
							"key": "categoria",
							"value": "Computadores"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "4. Intentar Crear con Precio Invalido (POST - Error 400)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code es 400 Bad Request\", function () {",
							"    pm.response.to.have.status(400);",
							"});",
							"",
							"pm.test(\"Tiempo de respuesta menor a 500ms\", function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(500);",
							"});",
							"",
							"pm.test(\"El payload de error contiene status 400 y mensaje explicativo\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.status).to.eql(400);",
							"    pm.expect(jsonData.error).to.eql('Bad Request');",
							"    pm.expect(jsonData.message).to.be.a('string');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"nombre\": \"Mouse Gamer\",\n    \"precio\": -15.0,\n    \"categoria\": \"Accesorios\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/productos",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"productos"
					]
				}
			},
			"response": []
		}
	]
}
